{
  "name": "claude-agent-router",
  "version": "0.5.3",
  "description": "A Claude Code plugin that discovers every installed skill and subagent, ranks them for the task at hand, and routes to the best one — fronted by the Hina assistant and a self-contained build team.",
  "publishConfig": { "access": "public" },
  "bin": {
    "claude-agent-router": "scripts/install.js"
  },
  "files": [
    "skills/",
    "assets/",
    "agents/",
    ".claude-plugin/",
    "hooks/",
    "data/registry.json",
    "data/marketplace.json",
    "scripts/",
    "workflows/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "echo '\\n  claude-agent-router installed. Run: npx claude-agent-router\\n'"
  },
  "keywords": [
    "claude-code",
    "agents",
    "skills",
    "router",
    "orchestration",
    "subagent",
    "dispatch"
  ],
  "author": {
    "name": "Ramana Reddy",
    "email": "ramanareddy1098@outlook.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamanaNani/agent-router.git"
  },
  "homepage": "https://github.com/RamanaNani/agent-router#readme"
}
